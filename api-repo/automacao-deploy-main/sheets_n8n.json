      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"nome\": \"{{ $json['Nome completo:'] }}\",\n  \"email\": \"{{ $json['Endereço de e-mail'] }}\",\n  \"curso\": \"{{ $json['Curso:'] }}\" ,\n  \"mentor\": \"{{ $json['Nome do(a) Mentor(a) Técnico(a):'] }}\",\n  \"matricula\": \"{{ $json['Matrícula:'] }}\",\n  \"projeto\": \"{{ $json['Projeto vinculado:'] }}\",\n  \"data_entrada\": \"{{ $json['Data em que entrou no Projeto:'] }}\",\n  \"respostas\": {\n    \"PENSAMENTO CRÍTICO & INOVAÇÃO\": [\n      \"{{ $json['1.1 Descrevo e exemplifico os elementos de um processo, dando contextos de onde eles ocorrem.'] }}\",\n\"{{ $json['1.2 Formulo perguntas sobre situações desconhecidas, a partir de informações coletadas por meio da observação.'] }}\",\n\"{{ $json['1.3 Determino as melhores soluções para um problema complexo e justifico a minha escolha.'] }}\",\n\"{{ $json['1.4 Analiso e explico os recursos utilizados, as soluções aplicadas e as conclusões geradas por uma investigação.'] }}\",\n\"{{ $json['1.5 Sintetizo informações de diferentes pontos de referência.'] }}\", \"{{ $json['1.6 Crio uma maneira inovadora de resolver problemas comuns.'] }}\"\n    ],\n    \"APRENDIZAGEM ATIVA & ESTRATÉGIAS DE APRENDIZAGEM\": [\n\"{{ $json['2.1 Gero novas maneiras de pensar.'] }}\", \"{{ $json['2.2 Compreendo os problemas, fazendo perguntas esclarecedoras para uma tomada de decisão. '] }}\", \"{{ $json['2.3 Proponho soluções e conclusões embasadas e avalio sua eficácia. '] }}\", \"{{ $json['2.4 Estimo a pesquisa, a origem dos dados e a atualização constante.'] }}\"\n    ],\n    \"CRIATIVIDADE, ORIGINALIDADE & INICIATIVA\": [\n\"{{ $json['3.1 Tenho disposição para assumir responsabilidades e encarar desafios.'] }}\", \"{{ $json['3.2 Experimento minhas próprias ideias e tomo decisões por conta própria.'] }}\", \"{{ $json['3.3 Planejo meu trabalho sem nenhuma supervisão.'] }}\", \"{{ $json['3.4 Apresento ideias incomuns ou inteligentes sobre determinado assunto ou situação.'] }}\", \"{{ $json['3.5 Desenvolvo formas criativas de resolver um problema.'] }}\", \"{{ $json['3.6 Estou aberto/a a novas experiências culturais e intelectuais.'] }}\"\n    ],\n    \"RESOLUÇÃO DE PROBLEMAS COMPLEXOS\": [\n \"{{ $json['4.1 Concretizo estratégias para organizar e analisar formas de resolução de problemas.'] }}\", \"{{ $json['4.2 Desenvolvo habilidades reflexivas, analíticas e de avaliação para resolver problemas e alcançar soluções.'] }}\", \"{{ $json['4.3 Identifico e analiso a origem dos problemas, agindo nas causas e não somente nos sintomas para garantir que não sejam recorrentes.'] }}\"\n    ],\n    \"LIDERANÇA & INFLUÊNCIA SOCIAL\": [\n     \"{{ $json['5.1 Expresso opiniões divergentes de forma construtiva, de maneira franca e respeitosa, não me intimidando em posicionar-me.'] }}\", \"{{ $json['5.2 Cultivo a escuta para elaborar uma boa comunicação na relação com outras pessoas.'] }}\", \"{{ $json['5.3 Comunico de forma objetiva, simples e clara, adequando minha linguagem aos diferentes públicos e checando o entendimento das pessoas.'] }}\", \"{{ $json['5.4 Demonstro clareza sobre meus interesses, pontos fortes e pontos a melhorar.'] }}\", \"{{ $json['5.5 Trabalho de forma colaborativa em atividades que envolvem diferentes áreas e pessoas.'] }}\", \"{{ $json['5.6 Ofereço ajuda quando percebo necessidades dentro ou até fora da minha área de atuação.'] }}\"\n    ],\n    \"EMPREENDEDORISMO\": [\n\"{{ $json['6.1 Atuo em prol da realização de um propósito coletivo, considerando os impactos e as consequências de suas atitudes e ações na cadeia de processo da organização. '] }}\", \"{{ $json['6.2 Antecipo problemas, agregando considerável valor para a área.'] }}\", \"{{ $json['6.3 Contribuo de forma voluntária para projetos e atividades.'] }}\", \"{{ $json['6.4 Ajo de forma proativa às oportunidades e dificuldades, para aproveitá-las ou corrigi-las, buscando ajuda necessária e/ou orientações específicas para iniciar minhas ações.'] }}\", \"{{ $json['6.5 Enfrento adversidades, resisto às frustrações, buscando estratégias construtivas para alcançar objetivos. '] }}\"\n    ]\n  },\n  \"observacao\": \"{{ $json[\"Deseja acrescentar alguma informação que não foi contemplada em alguma(as) da(s) questão(ões) ou até mesmo prover sugestões sobre este formulário? Fique à vontade para contribuir conosco fornecendo um feedback.\"] }}\"\n}            ",

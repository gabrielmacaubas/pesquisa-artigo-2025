    {
      "parameters": {
        "jsCode": "const limiteNota = 2.0;\nconst resultados = [];\nconst recomendacoesPorCompetencia = {};\n\n// pega as recomendações vindas do node Google Sheets (ajuste o nome do node se for diferente)\nconst recomendacoes = $items(\"Ler planilha de recomendações\");\nif (!recomendacoes || recomendacoes.length === 0) {\n  throw new Error(\"Nenhuma recomendação foi retornada do Google Sheets.\");\n}\n\n// agrupa recomendações por competência (minúsculas)\nrecomendacoes.forEach((recomendacao) => {\n  const competencia = recomendacao.json?.[\"Competências\"]?.toLowerCase?.();\n  const texto = recomendacao.json?.[\"Recomendações\"];\n  if (!competencia || !texto) return;\n\n  if (!recomendacoesPorCompetencia[competencia]) {\n    recomendacoesPorCompetencia[competencia] = [];\n  }\n  recomendacoesPorCompetencia[competencia].push(texto);\n});\n\n$input.all().forEach((item) => {\n  const aluno = item.json?.nome ?? \"Aluno(a)\";\n  const autoavaliacoes = Array.isArray(item.json?.autoavaliacoes) ? item.json.autoavaliacoes : [];\n  if (autoavaliacoes.length === 0) return;\n\n  // controla repetição de recomendações por competência PARA ESSE ALUNO\n  const recomendacoesUsadas = {};\n\n  function sorteiaRecomendacaoSemRepeticao(competencia) {\n    const key = competencia.toLowerCase();\n    const lista = recomendacoesPorCompetencia[key];\n    if (!lista || lista.length === 0) {\n      return \"Não há recomendações disponíveis para esta competência.\";\n    }\n\n    if (!recomendacoesUsadas[key]) {\n      recomendacoesUsadas[key] = new Set();\n    }\n\n    const usadas = recomendacoesUsadas[key];\n    const disponiveis = lista.filter((rec) => !usadas.has(rec));\n\n    if (disponiveis.length === 0) {\n      return \"Todas as recomendações já foram utilizadas para essa competência.\";\n    }\n\n    const sorteada = disponiveis[Math.floor(Math.random() * disponiveis.length)];\n    usadas.add(sorteada);\n    return sorteada;\n  }\n\n  // ordena por unidade\n  autoavaliacoes.sort((a, b) => parseInt(a?.unidade ?? 0, 10) - parseInt(b?.unidade ?? 0, 10));\n\n  autoavaliacoes.forEach((avaliacao, index) => {\n    const unidade = avaliacao?.unidade ?? \"\";\n\n    // notas da unidade atual\n    const notasPrincipais = Array.isArray(avaliacao?.notas) ? avaliacao.notas : [];\n    const notasSub = Array.isArray(avaliacao?.notas_sub_softskill) ? avaliacao.notas_sub_softskill : [];\n\n    const todasNotas = [\n      // todas as principais, exceto \"inteligência emocional\"\n      ...notasPrincipais.filter(\n        (n) => (n?.softskill ?? \"\").toLowerCase() !== \"inteligência emocional\"\n      ),\n      // sub-softskills de inteligência emocional, renomeadas como \"Inteligência Emocional: X\"\n      ...notasSub.map((notaSub) => {\n        const principal = notasPrincipais.find(\n          (n) => (n?.softskill ?? \"\").toLowerCase() === \"inteligência emocional\"\n        );\n        return principal\n          ? { ...notaSub, softskill: `${principal.softskill}: ${notaSub.softskill}` }\n          : notaSub;\n      }),\n    ];\n\n    todasNotas.forEach((notaObj) => {\n      const competencia = (notaObj?.softskill ?? \"\").toLowerCase();\n      const notaAtual = parseFloat(notaObj?.nota ?? NaN);\n\n      if (!competencia || Number.isNaN(notaAtual)) return;\n\n      let deveRecomendar = false;\n      let motivo = \"limite\"; // \"limite\" (abaixo de 2.5) ou \"queda\" (piorou em relação à unidade anterior)\n\n      // compara com unidade anterior, se existir\n      if (index > 0) {\n        const anterior = autoavaliacoes[index - 1];\n\n        const notasAntPrincipais = Array.isArray(anterior?.notas) ? anterior.notas : [];\n        const notasAntSub = Array.isArray(anterior?.notas_sub_softskill) ? anterior.notas_sub_softskill : [];\n\n        const notasAnt = [\n          ...notasAntPrincipais.filter(\n            (n) => (n?.softskill ?? \"\").toLowerCase() !== \"inteligência emocional\"\n          ),\n          ...notasAntSub.map((notaSub) => {\n            const principalAnt = notasAntPrincipais.find(\n              (n) => (n?.softskill ?? \"\").toLowerCase() === \"inteligência emocional\"\n            );\n            return principalAnt\n              ? { ...notaSub, softskill: `${principalAnt.softskill}: ${notaSub.softskill}` }\n              : notaSub;\n          }),\n        ];\n\n        const notaAntObj = notasAnt.find(\n          (n) => (n?.softskill ?? \"\").toLowerCase() === competencia\n        );\n        if (notaAntObj) {\n          const notaAnt = parseFloat(notaAntObj?.nota ?? NaN);\n          if (!Number.isNaN(notaAnt) && notaAtual < notaAnt) {\n            deveRecomendar = true;\n            motivo = \"queda\";\n          }\n        }\n      }\n\n      if (notaAtual < limiteNota || deveRecomendar) {\n        const textoMotivo =\n          motivo === \"queda\"\n            ? \"Recomendação por queda de desempenho\"\n            : \"Recomendação por desempenho abaixo da média\";\n\n        resultados.push({\n          Aluno: aluno,\n          Unidade: unidade,\n          Competência: competencia,\n          Nota: notaAtual,\n          Recomendações: sorteiaRecomendacaoSemRepeticao(competencia),\n          MotivoRecomendacao: textoMotivo,\n        });\n      }\n    });\n  });\n});\n\n// saída: um item por recomendação\nreturn resultados.map((res) => ({ json: res }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

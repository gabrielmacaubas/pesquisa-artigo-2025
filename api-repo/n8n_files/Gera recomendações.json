        "message": "=<div style=\"font-family: 'Poppins', Arial, sans-serif; background-color: #f5f5f5; padding: 20px;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.1);\">\n\n    <!-- Banner -->\n    <img src=\"https://jardsousa.github.io/img/foton8n.jpg\" alt=\"Banner\" style=\"width: 100%; display: block;\">\n\n    <!-- Conteúdo -->\n    <div style=\"padding: 20px;\">\n      <p style=\"font-size: 16px; color: #333;\">\n        Prezado(a) mentor(a),\n      </p>\n\n      <p style=\"font-size: 15px; color: #333; line-height: 1.5;\">\n        Segue em anexo o relatório com orientações personalizadas para o(a) aluno(a)\n        <strong style=\"color: #1a1a1a;\">{{ $('Analisar notas').first().json.Aluno }}</strong>, elaborado a partir das autoavaliações realizadas ao longo do percurso formativo.\n      </p>\n\n      <p style=\"font-size: 15px; color: #333;\">\n        Agradecemos sua dedicação e acompanhamento no processo de capacitação dos discentes.\n      </p>\n\n      <p style=\"font-size: 15px; color: #333;\">\n        Atenciosamente,<br>\n        <strong style=\"color: #1a1a1a;\">Equipe Capacitação 4.0</strong>\n      </p>\n    </div>\n\n    <!-- Rodapé -->\n    <div style=\"background-color: #FF15A8; color: #ffffff; text-align: center; padding: 10px 20px; font-size: 12px; margin-top: 20px;\">\n      Este e-mail foi gerado automaticamente pelo <strong>n8n</strong>\n    </div>\n\n  </div>\n</div>\n",

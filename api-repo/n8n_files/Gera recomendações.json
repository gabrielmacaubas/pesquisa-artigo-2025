    {
      "parameters": {
        "jsCode": "const parts = items.map((it) => Buffer\n  .from(it.binary.data.data, 'base64')\n  .toString('utf8')\n);\n\n\nconst merged = parts.join('\\n<!-- ==== separador ==== -->\\n');\n\n\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><title>Recomendações </title></head><body>\n${merged}\n</body></html>`;\n\nreturn [{\n  binary: {\n    data: {\n      data: Buffer.from(html, 'utf8').toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'index.html',\n    }\n  }\n}];\n"
      },

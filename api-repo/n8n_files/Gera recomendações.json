      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Recomendações de Melhorias</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    @page {\n      size: A4 portrait;\n    }\n\n    .page-break {\n      page-break-after: always;\n      break-after: page;\n    }\n\n    body {\n      font-family: 'Poppins', sans-serif;\n      margin: 0;\n      background-color: #ffffff;\n      color: #222;\n    }\n\n    .banner img {\n      width: 100%;\n      height: auto;\n      display: block;\n    }\n\n    .container {\n      padding: 30px 40px;        \n      max-width: 800px;          \n      margin: 20px auto;         \n    }\n\n    .info-block {\n      display: flex;\n      align-items: center;\n      margin-bottom: 10px;\n    }\n\n    .label {\n      background-color: #2c057f;\n      color: white;\n      padding: 10px 15px;\n      font-weight: bold;\n      border-top-left-radius: 8px;\n      border-bottom-left-radius: 8px;\n      min-width: 120px;\n    }\n\n    .value {\n      background-color: #f4f4f4;\n      padding: 10px 15px;\n      flex: 1;\n      border-top-right-radius: 8px;\n      border-bottom-right-radius: 8px;\n    }\n\n    .recommend-title {\n      background-color: #C5FFBC;\n      color: #FF15A8;\n      font-weight: bold;\n      padding: 10px 15px;\n      border-top-left-radius: 8px;\n      border-top-right-radius: 8px;\n      margin-top: 30px;\n    }\n\n    .recommend-content {\n      background-color: #e0ffe9;\n      padding: 15px;\n      border-bottom-left-radius: 8px;\n      border-bottom-right-radius: 8px;\n    }\n\n    .observation-title {\n      background-color: #fceabe;\n      color: #d4b338;\n      font-weight: bold;\n      padding: 10px 15px;\n      border-top-left-radius: 8px;\n      border-top-right-radius: 8px;\n      margin-top: 30px;\n    }\n\n    .observation-content {\n      background-color: #fff7e6;\n      padding: 15px;\n      border-bottom-left-radius: 8px;\n      border-bottom-right-radius: 8px;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"banner\">\n    <img src=\"https://jardsousa.github.io/img/foton8n.jpg\" alt=\"Imagem\" />\n  </div>\n\n  <div class=\"container\">\n\n    <div class=\"info-block\">\n      <div class=\"label\">Aluno</div>\n      <div class=\"value\">{{ $('Loop de recomendações').item.json.Aluno }}</div>\n    </div>\n    \n    <div class=\"info-block\">\n      <div class=\"label\">Unidade</div>\n      <div class=\"value\">{{ $('Loop de recomendações').item.json.Unidade }}</div>\n\n      <div class=\"label\" style=\"margin-left: 20px;\">Nota</div>\n      <div class=\"value\">{{ $('Loop de recomendações').item.json.Nota }}</div>\n    </div>\n\n    <div class=\"info-block\">\n      <div class=\"label\">Competência</div>\n      <div class=\"value\">{{ $('Loop de recomendações').item.json.Competência }}</div>\n    </div>\n   \n\n    <div class=\"recommend-title\">Recomendações</div>\n    <div class=\"recommend-content\">\n      {{ $('Loop de recomendações').item.json.Recomendações }}\n    </div>\n\n    <div class=\"observation-title\">Observações</div>\n    <div class=\"observation-content\">\n      {{ $('Loop de recomendações').item.json.MotivoRecomendacao }}\n    </div>\n\n  </div>\n\n  <div class=\"page-break\"></div>\n\n</body>\n</html>\n"
      },

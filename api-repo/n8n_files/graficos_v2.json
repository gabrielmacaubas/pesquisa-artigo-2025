        "functionCode": "const avaliacoes = $node['Get notas do discente1'].json.autoavaliacoes;\nlet resultado = '';\nfor (let i = 0, len = avaliacoes.length; i < len; ++i) {\n  let av = \"{label:'A\"+avaliacoes[i].unidade+' - '+avaliacoes[i].cadastrado_em+\"',data:[\"\n  for (let e = 0, len = avaliacoes[i].notas_sub_softskill.length; e < len; ++e) {\n    if (e == avaliacoes[i].notas_sub_softskill.length-1) {\n      av += avaliacoes[i].notas_sub_softskill[e].nota + ''\n    } else {\n      av += avaliacoes[i].notas_sub_softskill[e].nota + ', '\n    }\n  }\n  if (i == avaliacoes.length-1) {\n    av += \"], borderDash: [2, 2], fill: false}\"\n  } else {\n    av += \"], borderDash: [2, 2], fill: false},\"\n  }\n  resultado += av\n}\n\nreturn {\n  json: {\n    nome: items[0].json.nome,\n    data: resultado\n  }\n};"

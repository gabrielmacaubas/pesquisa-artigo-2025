    {
      "parameters": {
        "functionCode": "function converteNota(nota) {\n  nota = parseFloat(nota);\n  if (nota >= 0 && nota <= 1) {\n    return 'Abaixo do Básico';\n  } else if (nota <= 2) {\n    return 'Básico';\n  } else if (nota <= 3) {\n    return 'Adequado';\n  } else {\n    return 'Avançado';\n  }    \n}\n\nconst avaliacoes = $node['Get notas do discente1'].json.autoavaliacoes;\nlet colunas = '{\"width\":300, \"title\": \"SUBSOFT SKILLS\", \"dataIndex\":\"softskills\"},';\nlet autoavacao_unidade = 0;\n\nfor (let i = 0, len = avaliacoes.length; i < len; ++i) {\n  autoavacao_unidade = avaliacoes[i].unidade;\n  let av = '\"|\",\"|\", {\"title\":\"A' + autoavacao_unidade + '\", \"dataIndex\":\"col' + autoavacao_unidade + '\", \"align\": \"right\"}';\n  if (i == avaliacoes.length - 1) {\n    av += \"\";\n  } else {\n    av += \",\";\n  }\n  colunas += av;\n}\n\nconst notasPorSoftskill = {};\nconst data = $node['Get notas do discente1'].json.autoavaliacoes.forEach(autoavaliacao => {\n  autoavaliacao.notas_sub_softskill.forEach(notaObj => {\n    const softskill = notaObj.softskill;\n    const nota = notaObj.nota;\n    if (!notasPorSoftskill[softskill]) {\n      notasPorSoftskill[softskill] = [];\n    }\n    notasPorSoftskill[softskill].push(nota);\n  });\n});\n\nconst result = Object.keys(notasPorSoftskill).map(softskill => {\n  const notas = notasPorSoftskill[softskill];\n  const colunas = { softskills: softskill };\n  notas.forEach((nota, index) => {\n    colunas[`col${index + 1}`] = converteNota(nota);\n  });\n  return colunas;\n});\n\nfinalResult = [];\nfor (let object in result) {\n  finalResult.push('-');\n  finalResult.push('-');\n  finalResult.push(result[object]);\n}\n\nreturn {\n  json: {\n    nome: items[0].json.nome,\n    data_entrada: items[0].json.data_entrada,\n    colunas: colunas,\n    notas: finalResult\n  }\n};\n"
      },
